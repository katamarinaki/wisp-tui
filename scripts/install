#!/bin/sh
# Install from this checkout: project venv with hash-checked wheels, plus a
# launcher link in ~/.local/bin (default name `wi`). Safe to rerun. Python runs
# with -I so modules in the current directory are never imported. On first run
# it pins release-signers, the SSH keys whose tag signatures `update` accepts.
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
NAME=${1:-wi}
PYTHON=${PYTHON:-python3}
BIN="$HOME/.local/bin"
LINK="$BIN/$NAME"
TARGET="$ROOT/scripts/wisp-tui"
SIGNERS="$ROOT/release-signers"
PINNED="$HOME/.config/wisp-tui/release-signers"

case $NAME in
    wisp | -* | .* | *[!A-Za-z0-9._-]*)
        echo "install: invalid link name '$NAME' (not 'wisp'; letters, digits, . _ -)" >&2
        exit 2 ;;
esac
if ! "$PYTHON" -I -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    echo "install: needs Python 3.11+; set PYTHON=/path/to/python3.11 or newer" >&2
    exit 1
fi
if [ -e "$LINK" ] || [ -L "$LINK" ]; then
    if [ "$(readlink "$LINK" || true)" != "$TARGET" ]; then
        echo "install: $LINK already exists; remove it or pass another name: $0 NAME" >&2
        exit 1
    fi
fi

# Recreating in place also repairs a venv without pip (uv-made, half-built).
"$ROOT/.venv/bin/python" -I -m pip --version >/dev/null 2>&1 \
    || "$PYTHON" -I -m venv "$ROOT/.venv"
"$ROOT/.venv/bin/python" -I -m pip install --require-virtualenv --quiet --disable-pip-version-check \
    -r "$ROOT/requirements.txt"
mkdir -p "$BIN"
[ -L "$LINK" ] || ln -s "$TARGET" "$LINK"

# Pinned once: a later checkout can never swap the keys that verify updates.
if [ -e "$PINNED" ]; then
    :
elif [ -f "$SIGNERS" ]; then
    if ! grep -qv '^[[:space:]]*\(#\|$\)' "$SIGNERS"; then
        echo "install: release-signers lists no key" >&2
        exit 1
    fi
    mkdir -p "$HOME/.config"
    (umask 077 && mkdir -p "$HOME/.config/wisp-tui")
    STAGING="$PINNED.tmp.$$"
    trap 'rm -f "$STAGING"' EXIT
    (umask 077 && cp "$SIGNERS" "$STAGING")
    mv "$STAGING" "$PINNED"
    trap - EXIT
    echo "install: pinned these release signing keys; compare them with SECURITY.md:"
    awk '{ for (i = 1; i < NF; i++) if ($i ~ /^(ssh-|ecdsa-|sk-)/) { print $i, $(i + 1); break } }' \
        "$PINNED" | ssh-keygen -lf - || true
else
    echo "install: no release-signers file, so no key pinned; $NAME update stays off"
fi

case ":$PATH:" in
    *":$BIN:"*) ;;
    *) echo "install: add $BIN to your PATH to run $NAME from anywhere" ;;
esac
echo "install: done. Next: $NAME setup"
