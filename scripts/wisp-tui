#!/bin/sh
# wisp-tui launcher: runs the app from the project venv. Resolves its own
# location (through the ~/.local/bin symlink), so the checkout can live anywhere.
set -eu
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
exec env PYTHONPATH="$ROOT/src" "$ROOT/.venv/bin/python" -m wisp_tui "$@"
