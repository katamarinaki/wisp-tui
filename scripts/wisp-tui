#!/bin/sh
# wisp-tui launcher: runs the app from the project venv. Resolves its own
# location (through ~/.local/bin symlinks), so the checkout can live anywhere.
# Symlink it under any name (e.g. `wi`); help and errors use that name.
set -eu
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# -P: never import modules from the directory the launcher is started in.
# Run update/setup without importing Textual or loading private runtime config.
if [ "${1-}" = update ] || [ "${1-}" = setup ]; then
    command=$1
    shift
    exec env PYTHONPATH="$ROOT/src" WISP_TUI_PROG="$(basename "$0")" \
        "$ROOT/.venv/bin/python" -P -m "wisp_tui.$command" "$@"
fi
exec env PYTHONPATH="$ROOT/src" WISP_TUI_PROG="$(basename "$0")" \
    "$ROOT/.venv/bin/python" -P -m wisp_tui "$@"
